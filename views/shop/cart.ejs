<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/cart.css">
</head>

<body>
  <%- include('../includes/navigation.ejs') %>

  <main>

    <% if (products.length > 0) { %>

      <section class="cart">

        <ul class="cart__item-list">

          <% products.forEach(p => { %>

            <li class="cart__item">

              <div class="cart__item-info">
                <h2 class="cart__product-title">
                  <%= p.productId.title %>
                </h2>

                <p class="cart__product-quantity">
                  Quantity: <strong><%= p.quantity %></strong>
                </p>
              </div>

              <div class="cart__actions">

                <form action="/cart-delete-item" method="POST">

                  <input
                    type="hidden"
                    value="<%= p.productId._id %>"
                    name="productId"
                  >

                  <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                  >

                  <button class="btn danger" type="submit">
                    Delete
                  </button>

                </form>

              </div>

            </li>

          <% }) %>

        </ul>

      </section>

      <hr>

      <div class="centered cart__checkout">

        <!-- Order Form (Stripe replaced it) -->

        <!--
        <form action="/create-order" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn">Order Now!</button>
        </form>
        -->

        <a class="btn cart__order-btn" href="/checkout">
          Order Now
        </a>

      </div>

    <% } else { %>

      <div class="centered cart__empty">
        <h2>Your cart is empty 🛒</h2>
        <p>Add some products to start shopping.</p>
      </div>

    <% } %>

  </main>

  <%- include('../includes/end.ejs') %>